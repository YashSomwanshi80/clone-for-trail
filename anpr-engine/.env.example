# ============================================================
# ANPR Engine — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored; .env.example is committed.
# ============================================================

# ------ Security -----------------------------------------------
# Shared secret between Python (this service) and the Java backend.
# Must EXACTLY match anpr.internal-api-key in backend/src/main/resources/application.yaml.
# Python sends this as the X-Internal-Api-Key header on every call to /api/internal/*.
# Leave empty to disable inbound API-key enforcement on /infer/* routes (dev convenience only).
SERVICE_API_KEY=local-dev-internal-key-change-me

# ------ Java backend -------------------------------------------
# Base URL of the running Java backend (no trailing slash).
JAVA_BASE_URL=http://localhost:8080

# ------ Inference tuning ---------------------------------------
# "cuda" uses the first CUDA-capable GPU; falls back to "cpu" automatically if unavailable.
DEVICE=cuda

# YOLOv8 confidence threshold (0.0 – 1.0). Lower = more detections, more false positives.
DETECTION_CONF_THRESHOLD=0.4

# Process every Nth frame for /infer/video. Higher = faster but may miss fast plates.
FRAME_SKIP=2

# ------ Storage ------------------------------------------------
# Directory where plate-crop JPEG images are saved.
CROP_DIR=data/plate-crops

# Set to false to skip saving crops (useful for benchmarking or low-disk environments).
SAVE_CROPS=true

# ------ Model paths --------------------------------------------
YOLO_WEIGHTS_PATH=weights/plate_detector.pt
OCR_MODEL_NAME=global-plates-mobile-vit-v2-model
