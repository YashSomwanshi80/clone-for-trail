# ============================================================
# React Client — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored; .env.example is committed.
# All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.
# ============================================================

# ------ Backend URLs ------------------------------------------
# Java REST API base URL (no trailing slash).
VITE_JAVA_API_BASE_URL=http://localhost:8080

# Python ANPR engine base URL (no trailing slash).
VITE_PYTHON_API_BASE_URL=http://localhost:8000

# ------ WebSocket URLs ----------------------------------------
VITE_JAVA_WS_ALERTS_URL=ws://localhost:8080/ws/alerts
VITE_JAVA_WS_ANALYTICS_URL=ws://localhost:8080/ws/analytics/live

# ------ Mock mode ---------------------------------------------
# Set to "true" to run with generated mock data (no backend required).
# Set to "false" to connect to the real Java and Python services.
VITE_USE_MOCKS=true

# ------ City --------------------------------------------------
# cityId sent to Java's MediaRegisterRequest (POST /api/v1/media) and
# all /api/v1/analytics/* queries.
# This is stored as a plain string column in Postgres — no FK validation.
# For local dev any value works. In production, use a real city identifier.
VITE_DEFAULT_CITY_ID=default
